PORT=8787
# Leave SIMULATION_MODE=true until the MT5 demo agent has been tested.
SIMULATION_MODE=true
# Optional. A Discord bot bridge can post normalised messages to /api/signals.
DISCORD_BOT_TOKEN=
# Optional. Required only when receiving Discord interaction webhooks directly.
DISCORD_PUBLIC_KEY=
# XBTFX keys must be added only to this server's environment, never to the dashboard.
# Phase 2 remains demo-only even when a key is present.
XBTFX_API_BASE=https://interface.xbtfx.com
XBTFX_API_KEY=
XBTFX_LIVE_ENABLED=false
